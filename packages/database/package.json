{
  "name": "@whisky-hunter/database",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=../../.env src/migrate.ts",
    "db:seed": "tsx --env-file=../../.env src/seed/index.ts",
    "lint": "echo 'no lint yet' && exit 0",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "postgres": "3.4.9",
    "zod": "4.4.2",
    "@whisky-hunter/shared": "workspace:*"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.10",
    "vitest": "2.1.8",
    "@vitest/coverage-v8": "2.1.8",
    "tsx": "4.21.0",
    "typescript": "5.7.3"
  }
}
