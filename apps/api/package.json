{
  "name": "@whisky-hunter/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "build": "tsc",
    "start": "node --import tsx/esm src/index.ts",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch --env-file=.env src/index.ts",
    "test": "echo 'api tests in later phases' && exit 0",
    "lint": "echo 'no lint yet' && exit 0",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "hono": "4.6.14",
    "@hono/node-server": "1.13.7",
    "@hono/zod-validator": "0.4.3",
    "zod": "4.4.2",
    "@whisky-hunter/database": "workspace:*",
    "@whisky-hunter/shared": "workspace:*",
    "@whisky-hunter/search": "workspace:*",
    "drizzle-orm": "0.45.2",
    "postgres": "3.4.9",
    "better-auth": "1.3.0",
    "resend": "4.5.1",
    "stripe": "17.7.0",
    "tsx": "4.21.0"
  },
  "devDependencies": {
    "typescript": "5.7.3",
    "@types/node": "22.15.21"
  }
}
