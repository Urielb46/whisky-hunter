# PostgreSQL (Neon for dev, Railway for prod)
DATABASE_URL=postgresql://user:password@localhost:5432/whisky_hunter

# Redis (BullMQ + cache; Railway Redis for prod)
REDIS_URL=redis://localhost:6379

# Scraper proxy (Bright Data residential — leave blank in dev)
PROXY_URL=

# Node env
NODE_ENV=development

# Scraper feature flags
SCRAPER_HEADLESS=true
SCRAPER_DEFAULT_CRON=0 2 * * *

# Better Auth
BETTER_AUTH_SECRET=change-me-to-a-random-32-char-string

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Web
NEXT_PUBLIC_API_URL=http://localhost:3000

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM=

# Stripe (FREQ-03)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_ANNUAL=price_...

# API server port (Railway injects PORT automatically in production)
PORT=3000

# Worker concurrency (number of parallel scrape jobs)
WORKER_CONCURRENCY=2
