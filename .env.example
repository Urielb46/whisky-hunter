# ── Database ──────────────────────────────────────────────────────────────────
# Required. PostgreSQL connection string.
# Dev: Neon free tier  |  Prod: Railway PostgreSQL or Supabase
DATABASE_URL=postgresql://user:password@localhost:5432/whisky_hunter

# ── Redis (BullMQ + cache) ────────────────────────────────────────────────────
# Required. Used by BullMQ job queue and FX rate cache.
# Dev: local Redis  |  Prod: Railway Redis add-on
REDIS_URL=redis://localhost:6379

# ── API Server ────────────────────────────────────────────────────────────────
# Optional — Railway injects PORT automatically in production.
PORT=3000

# Required. "development" | "production" | "test"
NODE_ENV=development

# ── Auth (Better Auth) ────────────────────────────────────────────────────────
# Required. Random secret used to sign sessions — must be at least 32 chars.
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=change-me-to-a-random-32-char-string

# Optional. Public URL of the API server — used by Better Auth for OAuth redirects.
# Set to the Railway public domain after first deploy.
BETTER_AUTH_URL=http://localhost:3000

# Optional. Google OAuth credentials (leave blank to disable Google sign-in).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Stripe ────────────────────────────────────────────────────────────────────
# Required for billing features (freemium upgrade). Use test keys in dev.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Required. Stripe price IDs for the premium subscription plans.
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_ANNUAL=price_...

# ── Typesense ─────────────────────────────────────────────────────────────────
# Required for full-text search. Self-hosted defaults shown; adjust for Typesense Cloud.
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
# Required. Admin API key (use a search-only key on the read path if desired).
TYPESENSE_API_KEY=xyz

# ── Resend Email ──────────────────────────────────────────────────────────────
# Optional in dev (emails are skipped silently when key is absent).
# Required in production for email verification, password reset, and price alerts.
RESEND_API_KEY=re_...
# Optional. Sender address shown in outgoing emails.
RESEND_FROM=WhiskyHunter <onboarding@resend.dev>

# ── Web (Next.js public vars) ─────────────────────────────────────────────────
# Required. Base URL of the API server — must be prefixed NEXT_PUBLIC_ to be
# available in browser-side Next.js code and in the Expo mobile app.
NEXT_PUBLIC_API_URL=http://localhost:3000

# ── Scraper / Proxies ─────────────────────────────────────────────────────────
# Optional in dev. Residential proxy URL for Playwright (e.g. Bright Data).
# Leave blank locally; set in Railway scraper service for production.
PROXY_URL=

# Optional. Run Chromium in headless mode. Set to "false" for local debugging.
SCRAPER_HEADLESS=true

# Optional. Default fallback cron expression for retailers without a custom schedule.
SCRAPER_DEFAULT_CRON=0 2 * * *

# Optional. Number of parallel Playwright scrape jobs the BullMQ worker runs.
WORKER_CONCURRENCY=2
